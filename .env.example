# Unreleased Studio — biến môi trường cho M1-A (TideCloak)
# Copy sang .env (đã gitignored) rồi điền. KHÔNG commit .env.

# Email quản lý license Tide — chủ dự án tự điền email thật của mình (D10).
# Không dùng địa chỉ placeholder: script sẽ từ chối example.com, test.com, ...
TIDE_LICENSE_EMAIL=

# Chỉ đặt yes nếu chủ dự án đã đọc và đồng ý https://tide.org/legal
TIDE_TERMS_ACCEPTED=

# Mật khẩu master admin của TideCloak (tự sinh, chỉ dùng local).
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=

# Tên realm / client / URL app. Đổi trước khi bootstrap, không đổi được sau đó.
REALM_NAME=unreleased
CLIENT_NAME=unreleased-client
CLIENT_APP_URL=http://localhost:5137
TIDECLOAK_URL=http://localhost:8080
